       STATION_ID,
       ROUND(
           (CAST(END_TIME AS DATE) -
            CAST(START_TIME AS DATE)) * 1440
       ) AS DURATION_MINUTES
FROM EV_CHARGING_SESSIONS;



CREATE OR REPLACE FUNCTION CALCULATE_CHARGING_COST(
    P_ENERGY NUMBER,
    P_TARIFF NUMBER
)
RETURN NUMBER
IS
BEGIN
    RETURN P_ENERGY * P_TARIFF;
END;
/


SELECT CALCULATE_CHARGING_COST(20, 12) AS CHARGING_COST
FROM DUAL;



CREATE OR REPLACE PROCEDURE REGISTER_CHARGING_SESSION(
    P_SESSION_ID NUMBER,
    P_STATION_ID NUMBER,
    P_VEHICLE_ID VARCHAR2,
    P_START_TIME TIMESTAMP,
    P_END_TIME TIMESTAMP,
    P_ENERGY NUMBER,
    P_TARIFF NUMBER
)
IS
BEGIN
    INSERT INTO EV_CHARGING_SESSIONS
    VALUES (
        P_SESSION_ID,
        P_STATION_ID,
        P_VEHICLE_ID,
        P_START_TIME,
        P_END_TIME,
        P_ENERGY,
        P_TARIFF,
        P_ENERGY * P_TARIFF
    );

    DBMS_OUTPUT.PUT_LINE(
        'Charging session registered successfully'
    );

    DBMS_OUTPUT.PUT_LINE(
        'Total Cost: ' || (P_ENERGY * P_TARIFF)
    );

EXCEPTION
    WHEN DUP_VAL_ON_INDEX THEN
        DBMS_OUTPUT.PUT_LINE('Session ID already exists');

    WHEN OTHERS THEN
        DBMS_OUTPUT.PUT_LINE('Error: ' || SQLERRM);
        RAISE;
END;
/



