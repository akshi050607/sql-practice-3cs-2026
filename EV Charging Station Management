CREATE OR REPLACE PROCEDURE STATION_WISE_REPORT
IS
BEGIN
    FOR R IN (
        SELECT STATION_ID,
               SUM(ENERGY_KWH) AS TOTAL_ENERGY,
               SUM(REVENUE) AS TOTAL_REVENUE
        FROM EV_CHARGING_SESSIONS
        GROUP BY STATION_ID
        ORDER BY STATION_ID
    )
    LOOP
        DBMS_OUTPUT.PUT_LINE(
            'Station ID: ' || R.STATION_ID
        );

        DBMS_OUTPUT.PUT_LINE(
            'Total Energy: ' || R.TOTAL_ENERGY || ' kWh'
        );

        DBMS_OUTPUT.PUT_LINE(
            'Total Revenue: Rs. ' || R.TOTAL_REVENUE
        );

        
    END LOOP;
END;
/



BEGIN
    STATION_WISE_REPORT;
END;
/




SELECT *
FROM EV_CHARGING_SESSIONS
ORDER BY STATION_ID, START_TIME;



SELECT STATION_ID,
       COUNT(*) AS TOTAL_SESSIONS,
       SUM(ENERGY_KWH) AS TOTAL_ENERGY_KWH,
       SUM(REVENUE) AS TOTAL_REVENUE,
       ROUND(AVG(ENERGY_KWH), 2) AS AVG_ENERGY_KWH
FROM EV_CHARGING_SESSIONS
GROUP BY STATION_ID
ORDER BY STATION_ID;
